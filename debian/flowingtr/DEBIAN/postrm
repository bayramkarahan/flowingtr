#!/bin/sh
set -e

# Kalan MIME kayıtlarını sil
rm -f /usr/share/mime/packages/ftr.xml || true
update-mime-database /usr/share/mime || true

# Kalan .desktop kaydını sil
rm -f /usr/share/applications/flowingtr.desktop || true

# Simge önbelleğini güncelle
if [ -d /usr/share/icons/hicolor ]; then
    gtk-update-icon-cache -f /usr/share/icons/hicolor || true
fi

# Mevcut kullanıcıların mime cache’ini temizle
for userdir in /home/*; do
    username=$(basename "$userdir")
    if [ -f "$userdir/.local/share/mime/packages/ftr.xml" ]; then
        rm -f "$userdir/.local/share/mime/packages/ftr.xml" || true
        su - "$username" -c "update-mime-database ~/.local/share/mime" || true
    fi
done

exit 0

