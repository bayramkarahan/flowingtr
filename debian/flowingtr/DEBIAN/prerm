#!/bin/sh
set -e

echo "FlowingTR kaldırma işlemi başlatılıyor..."

# mimeapps.list'ten ilişkilendirmeyi kaldır
MIMEAPPS_LIST="/usr/share/applications/mimeapps.list"
if [ -f "$MIMEAPPS_LIST" ]; then
    sed -i '/application\/x-flowingtr-ftr/d' "$MIMEAPPS_LIST" || true
fi

# Simge önbelleğini güncelle
if [ -d /usr/share/icons/hicolor ]; then
    DISPLAY= gtk-update-icon-cache -f /usr/share/icons/hicolor || true
fi

echo "FlowingTR ilişkilendirmeleri kaldırıldı."
exit 0

